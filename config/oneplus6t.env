# VibeMarketOS target defaults. Override these variables for a staging host.
VIBEMARKET_DEVICE=oneplus-fajita
VIBEMARKET_COMPATIBLE=oneplus,fajita
VIBEMARKET_FIXES_REPOSITORY=https://github.com/lolren/oneplus6t-pmos-fixes.git
VIBEMARKET_SNAPSHOT_REPOSITORY=https://github.com/lolren/advanced-snapshot.git
VIBEMARKET_WAYDROID_ROOTFS=/var/lib/waydroid/rootfs
VIBEMARKET_WAYDROID_OVERLAY=/var/lib/waydroid/overlay
